# 硅基流动 SiliconFlow API 配置
# 使用方法：复制本文件为 .env 并填入真实 Key（.env 已被 .gitignore 排除，不会提交到 Git）
# 获取 API Key：https://cloud.siliconflow.cn

# 必填：API Key，Vibe Coding Agent 与 Conversation Navigator Agent 共用，仅服务端读取
SILICONFLOW_API_KEY=

# 选填：Vibe Coding Agent 使用的代码模型
SILICONFLOW_MODEL=moonshotai/Kimi-K2.7-Code

# 选填：AI 视觉增强使用的图像生成模型
SILICONFLOW_IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo

# 选填：Conversation Navigator Agent 对话模型（与 Vibe Coding 的 Kimi 配置相互独立）
NAVIGATOR_MODEL=deepseek-ai/DeepSeek-V4-Flash
